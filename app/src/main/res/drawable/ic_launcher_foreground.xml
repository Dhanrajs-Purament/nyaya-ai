<?xml version="1.0" encoding="utf-8"?>
<!--
  Nyaya AI Lawyer — adaptive launcher icon, foreground layer.

  The mark has to say three things at 48dp, in one read:

    * shield        -> end-to-end encryption and privacy (the bitchat heritage)
    * scales        -> Indian law, the reason the app exists
    * beam of nodes -> the peer-to-peer mesh and the on-device AI: the scales'
                       beam is literally a network graph, so "law" and
                       "encrypted AI network" are the same shape rather than two
                       icons crammed together

  All artwork stays inside the central 72x72 safe zone of the 108x108 adaptive
  viewport, so no launcher mask can crop it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield body -->
    <path
        android:pathData="M54,20 L83,29.5 L83,52.5 C83,70.5 70.5,82.5 54,89 C37.5,82.5 25,70.5 25,52.5 L25,29.5 Z"
        android:fillColor="#26FFFFFF"
        android:strokeColor="#8CFFFFFF"
        android:strokeWidth="2.2" />

    <!-- Scales: central post, base and foot -->
    <path android:pathData="M52.6,36 h2.8 v38 h-2.8 z" android:fillColor="#FFFFFFFF" />
    <path android:pathData="M45,74 h18 v3.2 h-18 z" android:fillColor="#FFFFFFFF" />
    <path android:pathData="M41.5,77.2 h25 v3.4 h-25 z" android:fillColor="#FFFFFFFF" />

    <!-- Beam of the scales, doubling as a mesh link -->
    <path android:pathData="M33,44 h42 v2.8 h-42 z" android:fillColor="#FFFFFFFF" />

    <!-- Hangers -->
    <path android:pathData="M33.4,46.8 h1.6 v6 h-1.6 z" android:fillColor="#D9FFFFFF" />
    <path android:pathData="M73,46.8 h1.6 v6 h-1.6 z" android:fillColor="#D9FFFFFF" />

    <!-- Pans -->
