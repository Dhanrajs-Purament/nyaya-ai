        android:strokeWidth="1.8" />
    <path
        android:pathData="M48.5,33.6 L34.2,45.4"
        android:strokeColor="#73F7C544"
        android:strokeWidth="1.5" />
    <path
        android:pathData="M59.5,33.6 L73.8,45.4"
        android:strokeColor="#73F7C544"
        android:strokeWidth="1.5" />

