        android:fillColor="#FFFFFFFF" />

    <!-- Mesh nodes riding the beam: the encrypted peer-to-peer fabric -->
    <path
        android:pathData="M34.2,45.4 m-4.2,0 a4.2,4.2 0 1,0 8.4,0 a4.2,4.2 0 1,0 -8.4,0 z"
